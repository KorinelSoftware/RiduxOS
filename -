PARTITIONS=DEFAULT
DISTRIBUTIONS="kernel.txz base.txz"
export nonInteractive="YES"
ROOTPASS_PLAIN="ridux"

#!/bin/sh
set -eux

# This setup script runs inside the target system chroot.

echo "hostname=ridux-freebsd" >> /etc/rc.conf
echo "ifconfig_DEFAULT=DHCP" >> /etc/rc.conf
echo "sshd_enable=YES" >> /etc/rc.conf
echo "moused_enable=YES" >> /etc/rc.conf
echo "dbus_enable=YES" >> /etc/rc.conf
echo "linux_enable=YES" >> /etc/rc.conf
echo "ridux_firstboot_enable=YES" >> /etc/rc.conf
echo "vboxguest_enable=YES" >> /etc/rc.conf
echo "vboxservice_enable=YES" >> /etc/rc.conf

if ! pw usershow "ridux" >/dev/null 2>&1; then
  pw useradd "ridux" -m -G wheel,operator -s /bin/sh -w none || true
fi
if pw groupshow video >/dev/null 2>&1; then
  pw groupmod video -m "ridux" || true
fi

mkdir -p /usr/local/bin /usr/local/etc/rc.d /usr/local/share/ridux "/home/ridux"

cat > "/usr/local/bin/ridux-browser" <<'RIDUX_BROWSER_EOF'
#!/bin/sh
set -eu

if [ -x /usr/bin/ridux-browser ]; then
  exec /usr/bin/ridux-browser "$@"
fi

pick_cmd() {
  _candidates="$1"
  for _cmd in $_candidates; do
    if command -v "$_cmd" >/dev/null 2>&1; then
      printf '%s\n' "$_cmd"
      return 0
    fi
  done
  return 1
}

start_live_postinstall() {
  if [ -x /usr/local/bin/ridux-live-postinstall ] && [ ! -f /var/db/ridux/live-postinstall.done ]; then
    if [ ! -f /var/db/ridux/live-postinstall.started ]; then
      mkdir -p /var/db/ridux /var/log || true
      touch /var/db/ridux/live-postinstall.started || true
      nohup /usr/local/bin/ridux-live-postinstall >/var/log/ridux-live-postinstall.log 2>&1 &
    fi
  fi
}

wait_for_cmd() {
  _candidates="$1"
  _timeout="${2:-240}"
  _elapsed=0
  start_live_postinstall
  while [ "$_elapsed" -lt "$_timeout" ]; do
    _picked="$(pick_cmd "$_candidates" 2>/dev/null || true)"
    if [ -n "$_picked" ]; then
      printf '%s\n' "$_picked"
      return 0
    fi
    sleep 2
    _elapsed=$((_elapsed + 2))
  done
  return 1
}

launch_cmd() {
  _cmd="$1"
  shift

  if [ "$(id -u)" -eq 0 ] 2>/dev/null; then
    case "$_cmd" in
      chromium*|chrome|google-chrome*|linux-chrome*)
        _profile="/tmp/ridux-chromium-profile"
        mkdir -p "$_profile" || true
        exec "$_cmd" --no-sandbox --user-data-dir="$_profile" "$@"
        ;;
      *)
        ;;
    esac
  fi

  exec "$_cmd" "$@"
}

target="${1:-chrome}"
if [ "$#" -gt 0 ]; then
  shift
fi

_candidates=""
_pkg_hint=""
case "$target" in
  chrome|google-chrome)
    _candidates="google-chrome linux-chrome linux-chrome-stable chromium chromium-browser firefox firefox-esr"
    _pkg_hint="chrome"
    ;;
  chromium)
    _candidates="chromium chromium-browser google-chrome-stable google-chrome linux-chrome firefox firefox-esr"
    _pkg_hint="chromium"
    ;;
  firefox)
    _candidates="firefox firefox-esr"
    _pkg_hint="firefox"
    ;;
  *)
    exec "$target" "$@"
    ;;
esac

_cmd="$(pick_cmd "$_candidates" 2>/dev/null || true)"
if [ -z "$_cmd" ]; then
  _cmd="$(wait_for_cmd "$_candidates" 300 2>/dev/null || true)"
fi

if [ -z "$_cmd" ] && [ -x /usr/local/bin/ridux-app ] && [ -n "$_pkg_hint" ]; then
  /usr/local/bin/ridux-app install "$_pkg_hint" >/tmp/ridux-browser-install.log 2>&1 || true
  _cmd="$(pick_cmd "$_candidates" 2>/dev/null || true)"
fi

if [ -z "$_cmd" ]; then
  echo "ridux-browser: $target not available yet." >&2
  echo "hint: tail -f /var/log/ridux-live-postinstall.log" >&2
  exit 1
fi

launch_cmd "$_cmd" "$@"

RIDUX_BROWSER_EOF
chmod 0755 "/usr/local/bin/ridux-browser"

cat > "/usr/local/bin/ridux-app" <<'RIDUX_APP_EOF'
#!/bin/sh
set -eu

SELF="$(basename "$0")"

usage() {
  cat <<'EOF'
Ridux App Manager (FreeBSD + Linux compatibility layer)

Usage:
  ridux-app list
  ridux-app status [app]
  ridux-app ensure-linux
  ridux-app install <app|all>
  ridux-app run <app> [args...]
  ridux-app doctor

Apps:
  firefox      Native Firefox package
  chromium     Native Chromium package
  chrome       Linux Chrome (linuxulator) with Chromium/Firefox fallback
  vlc          Video player
  thunderbird  Mail client
  gimp         Image editor
  libreoffice  Office suite
  obs          OBS Studio (candidates: obs-studio/obs)
  telegram     Telegram Desktop
  discord      Discord client
EOF
}

log() {
  printf '%s\n' "$*"
}

warn() {
  printf 'warning: %s\n' "$*" >&2
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    die "this action requires root. Use sudo or run as root."
  fi
}

prepare_pkg() {
  if ! command -v pkg >/dev/null 2>&1; then
    die "pkg command not found"
  fi
  env ASSUME_ALWAYS_YES=yes pkg bootstrap -f >/dev/null 2>&1 || true
  pkg update -f >/dev/null 2>&1 || warn "pkg update failed (network/repo issue)."
}

app_known() {
  case "$1" in
    firefox|chromium|chrome|vlc|thunderbird|gimp|libreoffice|obs|telegram|discord)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

app_package_candidates() {
  case "$1" in
    firefox)      printf '%s\n' "firefox" ;;
    chromium)     printf '%s\n' "chromium" ;;
    chrome)       printf '%s\n' "linux-chrome linux-chrome-stable" ;;
    vlc)          printf '%s\n' "vlc" ;;
    thunderbird)  printf '%s\n' "thunderbird" ;;
    gimp)         printf '%s\n' "gimp" ;;
    libreoffice)  printf '%s\n' "libreoffice" ;;
    obs)          printf '%s\n' "obs-studio obs" ;;
    telegram)     printf '%s\n' "telegram-desktop telegram" ;;
    discord)      printf '%s\n' "discord" ;;
    *)
      return 1
      ;;
  esac
}

app_command_candidates() {
  case "$1" in
    firefox)      printf '%s\n' "firefox" ;;
    chromium)     printf '%s\n' "chromium" ;;
    chrome)       printf '%s\n' "google-chrome linux-chrome linux-chrome-stable chromium firefox" ;;
    vlc)          printf '%s\n' "vlc" ;;
    thunderbird)  printf '%s\n' "thunderbird" ;;
    gimp)         printf '%s\n' "gimp" ;;
    libreoffice)  printf '%s\n' "libreoffice libreoffice7.6 libreoffice7.5" ;;
    obs)          printf '%s\n' "obs obs-studio" ;;
    telegram)     printf '%s\n' "telegram-desktop telegram" ;;
    discord)      printf '%s\n' "discord" ;;
    *)
      return 1
      ;;
  esac
}

all_apps() {
  printf '%s\n' \
    firefox \
    chromium \
    chrome \
    vlc \
    thunderbird \
    gimp \
    libreoffice \
    obs \
    telegram \
    discord
}

first_command_found() {
  _candidates="$1"
  for _cmd in $_candidates; do
    if command -v "$_cmd" >/dev/null 2>&1; then
      printf '%s\n' "$_cmd"
      return 0
    fi
  done
  return 1
}

ensure_fstab_entry() {
  _line="$1"
  _fstab="/etc/fstab"
  if [ ! -f "$_fstab" ]; then
    : > "$_fstab"
  fi
  if ! grep -Fqx "$_line" "$_fstab"; then
    printf '%s\n' "$_line" >> "$_fstab"
  fi
}

load_module_if_missing() {
  _mod="$1"
  if ! kldstat -q -m "$_mod" >/dev/null 2>&1; then
    kldload "$_mod" >/dev/null 2>&1 || true
  fi
}

ensure_linux_runtime() {
  need_root
  sysrc linux_enable=YES >/dev/null 2>&1 || true

  _mods="$(sysrc -n kld_list 2>/dev/null || true)"
  for _mod in linux linux64 linprocfs linsysfs; do
    case " ${_mods:-} " in
      *" $_mod "*) ;;
      *) _mods="${_mods:-} $_mod" ;;
    esac
  done
  _mods="$(printf '%s' "$_mods" | awk '{$1=$1; print}')"
  [ -n "$_mods" ] && sysrc kld_list="$_mods" >/dev/null 2>&1 || true

  mkdir -p /compat/linux/proc /compat/linux/sys
  ensure_fstab_entry "linproc /compat/linux/proc linprocfs rw 0 0"
  ensure_fstab_entry "linsys /compat/linux/sys linsysfs rw 0 0"

  load_module_if_missing linux
  load_module_if_missing linux64
  load_module_if_missing linprocfs
  load_module_if_missing linsysfs

  mount -t linprocfs linproc /compat/linux/proc >/dev/null 2>&1 || true
  mount -t linsysfs linsys /compat/linux/sys >/dev/null 2>&1 || true
}

install_first_available_pkg() {
  _candidate_list="$1"
  for _pkg in $_candidate_list; do
    if pkg info "$_pkg" >/dev/null 2>&1; then
      return 0
    fi
    if pkg install -y "$_pkg"; then
      return 0
    fi
  done
  return 1
}

install_app() {
  _app="$1"
  app_known "$_app" || die "unknown app: $_app"

  need_root
  prepare_pkg

  if [ "$_app" = "chrome" ]; then
    ensure_linux_runtime
    if ! install_first_available_pkg "linux_base-rl9 linux_base-c7"; then
      warn "could not install linux base package (linuxulator apps may fail)."
    fi
  fi

  _pkgs="$(app_package_candidates "$_app")"
  if ! install_first_available_pkg "$_pkgs"; then
    die "package installation failed for app '$_app' (candidates: $_pkgs)"
  fi

  if [ "$_app" = "chrome" ] && ! command -v google-chrome >/dev/null 2>&1; then
    if command -v linux-chrome >/dev/null 2>&1; then
      ln -sf "$(command -v linux-chrome)" /usr/local/bin/google-chrome
    elif command -v linux-chrome-stable >/dev/null 2>&1; then
      ln -sf "$(command -v linux-chrome-stable)" /usr/local/bin/google-chrome
    fi
  fi

  log "[ok] installed: $_app"
}

run_app() {
  _app="$1"
  shift

  case "$_app" in
    chrome|chromium|firefox)
      exec /usr/local/bin/ridux-browser "$_app" "$@"
      ;;
  esac

  if app_known "$_app"; then
    _cmds="$(app_command_candidates "$_app")"
    _cmd="$(first_command_found "$_cmds" || true)"
    if [ -z "${_cmd:-}" ]; then
      die "app '$_app' is not installed. Run: ridux-app install $_app"
    fi
    exec "$_cmd" "$@"
  fi

  exec "$_app" "$@"
}

print_linux_runtime_status() {
  _enabled="no"
  _mod_linux="no"
  _mod_linux64="no"
  _mount_proc="no"
  _mount_sys="no"

  if [ "$(sysrc -n linux_enable 2>/dev/null || true)" = "YES" ]; then
    _enabled="yes"
  fi
  kldstat -q -m linux >/dev/null 2>&1 && _mod_linux="yes" || true
  kldstat -q -m linux64 >/dev/null 2>&1 && _mod_linux64="yes" || true
  mount | grep -q 'on /compat/linux/proc (linprocfs' && _mount_proc="yes" || true
  mount | grep -q 'on /compat/linux/sys (linsysfs' && _mount_sys="yes" || true

  printf 'linux_enable=%s\n' "$_enabled"
  printf 'module_linux=%s\n' "$_mod_linux"
  printf 'module_linux64=%s\n' "$_mod_linux64"
  printf 'linprocfs_mounted=%s\n' "$_mount_proc"
  printf 'linsysfs_mounted=%s\n' "$_mount_sys"
}

show_status_for_app() {
  _app="$1"
  app_known "$_app" || die "unknown app: $_app"

  _cmds="$(app_command_candidates "$_app")"
  _found="$(first_command_found "$_cmds" || true)"
  if [ -n "$_found" ]; then
    printf '%-12s installed (%s)\n' "$_app" "$_found"
  else
    printf '%-12s missing\n' "$_app"
  fi
}

show_status() {
  _one="${1:-}"
  printf 'Ridux app status on %s\n' "$(uname -sr)"
  print_linux_runtime_status
  echo "display=${DISPLAY:-<none>}"
  echo

  if [ -n "$_one" ]; then
    show_status_for_app "$_one"
    return 0
  fi

  for _app in $(all_apps); do
    show_status_for_app "$_app"
  done
}

doctor() {
  echo "=== Ridux App Doctor ==="
  echo "host: $(uname -a)"
  echo
  show_status "${1:-}"
  echo
  if [ "${DISPLAY:-}" = "" ]; then
    echo "hint: DISPLAY is not set. Start an X session (startx) before GUI apps."
  fi
  if ! command -v pkg >/dev/null 2>&1; then
    echo "hint: pkg is missing."
  fi
  if ! command -v firefox >/dev/null 2>&1 && ! command -v chromium >/dev/null 2>&1; then
    echo "hint: install at least one browser:"
    echo "  sudo ridux-app install firefox"
    echo "  sudo ridux-app install chromium"
  fi
  if ! command -v google-chrome >/dev/null 2>&1 && \
     ! command -v linux-chrome >/dev/null 2>&1 && \
     ! command -v linux-chrome-stable >/dev/null 2>&1; then
    echo "hint: for Linux Chrome support:"
    echo "  sudo ridux-app ensure-linux"
    echo "  sudo ridux-app install chrome"
  fi
}

list_apps_cmd() {
  cat <<'EOF'
firefox      native browser
chromium     native browser
chrome       linuxulator chrome with fallback to chromium/firefox
vlc          media player
thunderbird  mail client
gimp         image editor
libreoffice  office suite
obs          streaming/recording
telegram     messaging
discord      voice/chat
EOF
}

cmd="${1:-help}"

case "$cmd" in
  help|-h|--help)
    usage
    ;;
  list)
    list_apps_cmd
    ;;
  ensure-linux)
    ensure_linux_runtime
    echo "[ok] linux compatibility runtime prepared."
    ;;
  status)
    shift || true
    show_status "${1:-}"
    ;;
  install)
    shift || true
    [ $# -ge 1 ] || die "install requires <app|all>"
    if [ "$1" = "all" ]; then
      _failed=0
      for _app in $(all_apps); do
        if ! install_app "$_app"; then
          warn "failed installing $_app"
          _failed=1
        fi
      done
      [ "$_failed" -eq 0 ] || exit 1
    else
      install_app "$1"
    fi
    ;;
  run)
    shift || true
    [ $# -ge 1 ] || die "run requires <app>"
    _app="$1"
    shift || true
    run_app "$_app" "$@"
    ;;
  doctor)
    shift || true
    doctor "${1:-}"
    ;;
  *)
    die "unknown command: $cmd (run '$SELF help')"
    ;;
esac

RIDUX_APP_EOF
chmod 0755 "/usr/local/bin/ridux-app"

cat > "/usr/local/bin/ridux-compat" <<'RIDUX_COMPAT_EOF'
#!/bin/sh
set -eu

if [ -x /usr/bin/ridux-compat ]; then
  exec /usr/bin/ridux-compat "$@"
fi

SELF="$(basename "$0")"
if [ "$SELF" != "ridux-compat" ] && [ "$SELF" != "ridux-compat.sh" ]; then
  # Allow command aliases via symlinks (abi6, dynlink, mmaps, etc.)
  set -- "$SELF" "$@"
fi

say() {
  printf '%s\n' "$*"
}

warn() {
  printf 'warning: %s\n' "$*" >&2
}

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    warn "command not available: $1"
    return 1
  fi
  return 0
}

default_pid() {
  printf '%s\n' "${1:-$$}"
}

cmd_help() {
  cat <<'EOF'
Ridux compat bridge (FreeBSD track)

Ridux-style commands:
  abi6 pidfd io_uring statx sysplus
  lsblk route mount lsdev catproc syscalls
  threads ss elf64 pmm tasks paging shm timers fds
  realsys mmaps procfs dynlink libc dlsym heap bsd b64 rng
  browser help|check|run|realrun [target]

Examples:
  abi6
  browser check chrome
  browser run firefox
  statx /usr/local/bin/chromium
  dynlink /usr/local/bin/firefox
  mmaps 1
EOF
}

cmd_abi6() {
  say "ridux abi6 bridge: FreeBSD compatibility summary"
  say "host: $(uname -sr)"
  say "kernel: $(uname -v)"
  say "linux_enable=$(sysrc -n linux_enable 2>/dev/null || echo NO)"

  if command -v kldstat >/dev/null 2>&1; then
    for _m in linux linux64 linprocfs linsysfs; do
      if kldstat -q -m "$_m" >/dev/null 2>&1; then
        say "module:${_m}=loaded"
      else
        say "module:${_m}=missing"
      fi
    done
  fi

  if command -v ridux-app >/dev/null 2>&1; then
    say
    ridux-app status chrome || true
  fi
}

cmd_pidfd() {
  say "pidfd bridge status"
  say "Linux pidfd is mapped to FreeBSD process primitives where possible."
  say "Native tools:"
  say "  pdfork/pdwait/pdkill (Capsicum process descriptors)"
  say "  procstat, ps, kill"
  if need_cmd procstat; then
    procstat -b 1 2>/dev/null | sed -n '1,12p' || true
  fi
}

cmd_io_uring() {
  say "io_uring bridge status"
  say "FreeBSD equivalent path: kqueue + aio + async I/O syscalls."
  if need_cmd sysctl; then
    sysctl kern.osrelease kern.ostype 2>/dev/null || true
  fi
}

cmd_statx() {
  _path="${1:-}"
  [ -n "$_path" ] || {
    warn "usage: statx <path>"
    return 2
  }
  if need_cmd stat; then
    stat -x "$_path"
  fi
}

cmd_sysplus() {
  say "system summary"
  uname -a
  if need_cmd sysctl; then
    sysctl kern.ostype kern.osrelease hw.machine hw.model 2>/dev/null || true
    sysctl vm.stats.vm.v_page_count vm.stats.vm.v_free_count 2>/dev/null || true
  fi
}

cmd_lsblk() {
  if need_cmd geom; then
    geom disk list
    return 0
  fi
  if need_cmd camcontrol; then
    camcontrol devlist
  fi
}

cmd_route() {
  if need_cmd netstat; then
    netstat -rn
  fi
}

cmd_mount() {
  mount
}

cmd_lsdev() {
  if need_cmd devinfo; then
    devinfo -rv | sed -n '1,180p'
    return 0
  fi
  ls /dev | sed -n '1,120p'
}

cmd_catproc() {
  _path="${1:-/proc/curproc/status}"
  if [ -f "$_path" ]; then
    cat "$_path"
  else
    warn "path not found: $_path"
    warn "tip: enable procfs if needed (mount -t procfs proc /proc)"
    return 1
  fi
}

cmd_syscalls() {
  say "syscall inspection bridge"
  say "Use truss for live syscall tracing:"
  say "  truss -f <command>"
  if need_cmd procstat; then
    procstat -kk 1 2>/dev/null | sed -n '1,40p' || true
  fi
}

cmd_threads() {
  _pid="$(default_pid "${1:-}")"
  if need_cmd procstat; then
    procstat -t "$_pid"
  fi
}

cmd_ss() {
  if need_cmd sockstat; then
    sockstat -4 -6 -l
  fi
}

cmd_elf64() {
  _bin="${1:-}"
  [ -n "$_bin" ] || {
    warn "usage: elf64 <path-to-binary>"
    return 2
  }
  if need_cmd file; then
    file "$_bin"
  fi
  if need_cmd ldd; then
    ldd "$_bin" || true
  fi
}

cmd_pmm() {
  if need_cmd sysctl; then
    sysctl \
      vm.stats.vm.v_page_count \
      vm.stats.vm.v_free_count \
      vm.stats.vm.v_inactive_count \
      vm.stats.vm.v_cache_count \
      vm.stats.vm.v_wire_count 2>/dev/null || true
  fi
}

cmd_tasks() {
  ps -ax -o pid,ppid,stat,ni,pri,comm
}

cmd_paging() {
  if need_cmd vmstat; then
    vmstat -s
  fi
}

cmd_shm() {
  if need_cmd ipcs; then
    ipcs -m
  else
    warn "ipcs not available"
  fi
}

cmd_timers() {
  _pid="$(default_pid "${1:-}")"
  if need_cmd procstat; then
    procstat -k "$_pid" 2>/dev/null || {
      warn "procstat -k failed for pid $_pid"
      return 1
    }
  fi
}

cmd_fds() {
  _pid="$(default_pid "${1:-}")"
  if need_cmd procstat; then
    procstat -f "$_pid"
  fi
}

cmd_realsys() {
  cmd_sysplus
  say
  cmd_abi6
  say
  cmd_ss || true
}

cmd_mmaps() {
  _pid="$(default_pid "${1:-}")"
  if need_cmd procstat; then
    procstat -v "$_pid"
  fi
}

cmd_procfs() {
  mount | grep ' /proc ' || say "procfs not mounted"
  mount | grep '/compat/linux/proc' || say "linprocfs not mounted"
  mount | grep '/compat/linux/sys' || say "linsysfs not mounted"
}

cmd_dynlink() {
  _bin="${1:-}"
  [ -n "$_bin" ] || {
    warn "usage: dynlink <binary>"
    return 2
  }
  if need_cmd ldd; then
    ldd "$_bin"
  fi
}

cmd_libc() {
  if [ -f /lib/libc.so.7 ]; then
    say "/lib/libc.so.7"
  fi
  if [ -f /usr/lib/libc.so ]; then
    say "/usr/lib/libc.so"
  fi
  if need_cmd ldd; then
    ldd /bin/sh 2>/dev/null || true
  fi
}

cmd_dlsym() {
  _lib="${1:-}"
  _sym="${2:-}"
  [ -n "$_lib" ] || {
    warn "usage: dlsym <library> <symbol>"
    return 2
  }
  [ -n "$_sym" ] || {
    warn "usage: dlsym <library> <symbol>"
    return 2
  }

  if command -v readelf >/dev/null 2>&1; then
    readelf -Ws "$_lib" | grep -F "$_sym" || true
    return 0
  fi
  if command -v nm >/dev/null 2>&1; then
    nm -D "$_lib" 2>/dev/null | grep -F "$_sym" || true
    return 0
  fi
  warn "neither readelf nor nm available"
  return 1
}

cmd_heap() {
  if need_cmd vmstat; then
    vmstat -m | sed -n '1,80p'
  fi
}

cmd_bsd() {
  say "Ridux FreeBSD track is active."
  uname -a
}

cmd_b64() {
  _mode="${1:-enc}"
  _data="${2:-}"
  case "$_mode" in
    enc|encode)
      if [ -n "$_data" ]; then
        printf '%s' "$_data" | base64
      else
        base64
      fi
      ;;
    dec|decode)
      if [ -n "$_data" ]; then
        if ! printf '%s' "$_data" | base64 -d 2>/dev/null; then
          printf '%s' "$_data" | base64 -D
        fi
      else
        if ! base64 -d 2>/dev/null; then
          base64 -D
        fi
      fi
      ;;
    *)
      warn "usage: b64 [enc|dec] [data]"
      return 2
      ;;
  esac
}

cmd_rng() {
  _count="${1:-32}"
  if need_cmd dd && need_cmd hexdump; then
    dd if=/dev/urandom bs=1 count="$_count" 2>/dev/null | hexdump -C
  fi
}

cmd_browser() {
  _sub="${1:-help}"
  _target="${2:-chrome}"
  shift 2 >/dev/null 2>&1 || true

  case "$_sub" in
    help)
      cat <<'EOF'
browser commands:
  browser check [chrome|firefox|chromium]
  browser run [chrome|firefox|chromium] [args...]
  browser realrun [chrome|firefox|chromium] [args...]
EOF
      ;;
    check)
      _cand=""
      case "$_target" in
        chrome|google-chrome)
          _cand="google-chrome linux-chrome linux-chrome-stable chromium firefox"
          ;;
        chromium)
          _cand="chromium chrome google-chrome firefox"
          ;;
        firefox)
          _cand="firefox"
          ;;
        *)
          _cand="$_target"
          ;;
      esac
      for _c in $_cand; do
        if command -v "$_c" >/dev/null 2>&1; then
          say "[ok] $_c -> $(command -v "$_c")"
          return 0
        fi
      done
      say "[missing] no executable found for target: $_target"
      return 1
      ;;
    run|realrun)
      if command -v ridux-browser >/dev/null 2>&1; then
        exec ridux-browser "$_target" "$@"
      fi
      exec "$_target" "$@"
      ;;
    *)
      warn "unknown browser subcommand: $_sub"
      return 2
      ;;
  esac
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  help|-h|--help) cmd_help ;;
  abi6) cmd_abi6 "$@" ;;
  pidfd) cmd_pidfd "$@" ;;
  io_uring) cmd_io_uring "$@" ;;
  statx) cmd_statx "$@" ;;
  sysplus) cmd_sysplus "$@" ;;
  lsblk) cmd_lsblk "$@" ;;
  route) cmd_route "$@" ;;
  mount) cmd_mount "$@" ;;
  lsdev) cmd_lsdev "$@" ;;
  catproc) cmd_catproc "$@" ;;
  syscalls) cmd_syscalls "$@" ;;
  threads) cmd_threads "$@" ;;
  ss) cmd_ss "$@" ;;
  elf64) cmd_elf64 "$@" ;;
  pmm) cmd_pmm "$@" ;;
  tasks) cmd_tasks "$@" ;;
  paging) cmd_paging "$@" ;;
  shm) cmd_shm "$@" ;;
  timers) cmd_timers "$@" ;;
  fds) cmd_fds "$@" ;;
  realsys) cmd_realsys "$@" ;;
  mmaps) cmd_mmaps "$@" ;;
  procfs) cmd_procfs "$@" ;;
  dynlink) cmd_dynlink "$@" ;;
  libc) cmd_libc "$@" ;;
  dlsym) cmd_dlsym "$@" ;;
